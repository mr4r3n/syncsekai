# ==========================================
# SyncSekai - Plantilla de Variables de Entorno para Producción
# ==========================================

# Base de Datos PostgreSQL
POSTGRES_USER=plexsync_user
POSTGRES_PASSWORD=tu_contraseña_segura_de_postgres_aqui
POSTGRES_DB=plexsync_db

# Seguridad y Criptografía (Cambiar por cadenas aleatorias de 32 o 64 caracteres)
JWT_SECRET=genera_una_cadena_secreta_para_jwt_aqui
JWT_ISSUER=plexsync
JWT_AUDIENCE=plexsync-web
OAUTH_STATE_SECRET=genera_otra_cadena_aleatoria_independiente_de_32_bytes
SETUP_BOOTSTRAP_TOKEN=genera_un_token_aleatorio_independiente_de_32_bytes
ENCRYPTION_KEY=genera_una_clave_hex_de_32_bytes_para_aes256_gcm

# Red y proxies (ajusta solo si existe un proxy inverso confiable)
TRUST_PROXY_HOPS=1
# Hosts (coincidencia exacta) o prefijos de IP terminados en punto desde los que
# se acepta el panel de administracion. Las direcciones privadas y de loopback
# pasan siempre. Ejemplo: admin.tudominio.com,10.0.
ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1
TRUST_CLOUDFLARE_HEADERS=false
PLEX_ALLOWED_PORTS=32400,443
PLEX_ALLOW_PUBLIC_URLS=false

# Dominios y Enlaces Públicos
FRONTEND_URL=https://sync.tudominio.com
NEXT_PUBLIC_API_URL=https://sync.tudominio.com/api

# Credenciales OAuth de Proveedores (Opcionales para login 1-clic).
# Tambien se pueden poner y rotar despues desde el panel, en
# Administracion -> Credenciales del sistema, que las guarda cifradas en la
# base de datos. Lo que este ahi tiene prioridad sobre lo que haya aqui.
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
KITSU_CLIENT_ID=
KITSU_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
PLEX_CLIENT_ID=

# Correo saliente. Sin SMTP_HOST no se envia nada, y eso deja fuera la
# activacion de cuenta, el restablecimiento de contrasena y los codigos de
# verificacion. No hay ningun otro proveedor detras.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SyncSekai <noreply@tudominio.com>

# IP privada del servidor accesible únicamente por el proxy inverso
FRONTEND_BIND_IP=10.0.0.10
