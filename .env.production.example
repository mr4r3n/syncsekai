# ==========================================
# SyncSekai - production environment template
# ==========================================

# PostgreSQL
POSTGRES_USER=plexsync_user
POSTGRES_PASSWORD=your_strong_postgres_password
POSTGRES_DB=plexsync_db

# Security (random strings of 32 or 64 characters)
JWT_SECRET=random_secret_for_jwt
JWT_ISSUER=plexsync
JWT_AUDIENCE=plexsync-web
OAUTH_STATE_SECRET=another_independent_random_32_byte_string
SETUP_BOOTSTRAP_TOKEN=independent_random_32_byte_token
ENCRYPTION_KEY=32_byte_hex_key_for_aes256_gcm

# Media servers on a private network. Users can only connect a Plex, Jellyfin or
# Emby server on a private address if it is listed here (exact IPs, or prefixes
# ending in a dot); otherwise anyone could point the backend at your internal
# network. Public servers are always accepted. Example: 192.168.1.20,10.0.5.
MEDIA_PRIVATE_ALLOWLIST=

# Public URL
FRONTEND_URL=https://sync.yourdomain.com

# OAuth providers (AniList, MyAnimeList, Kitsu, Google, Discord, Plex) and outgoing
# mail (SMTP) are set from the panel, in Administration -> System credentials, which
# stores them encrypted in the database. Without SMTP, account activation, password
# reset and verification codes are not sent.

# Discord bot that sends direct-message alerts (optional)
DISCORD_BOT_TOKEN=

# Private IP the frontend listens on, reachable only by the reverse proxy
FRONTEND_BIND_IP=10.0.0.10
